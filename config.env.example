# Copy to .env (next to docker-compose.yml). It holds your password, so don't share or commit it.
#
# Gmail SMTP + App Password. No Google Cloud project and no API registration.
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Put the 16-character password below without spaces.
# Other providers: Brevo  smtp-relay.brevo.com 587 starttls  |  Outlook  smtp.office365.com 587 starttls
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=you@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com
MAIL_SUBJECT=Screenshot {filename}
MAX_UPLOAD_MB=25
