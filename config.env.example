# Copy to .env (next to docker-compose.yml). It holds your password, so don't share or commit it.
#
# Everything below except ADMIN_PASSWORD can also be set from the web page at http://<server>:8989/
# Values saved on that page override this file.

# Password for the settings web page (any username). Strongly recommended:
# without it, anyone on your network can change where screenshots are sent.
ADMIN_PASSWORD=
#
# Gmail App Password. No Google Cloud project and no API registration. The same password is used
# to READ the inbox (IMAP) and to SEND the screenshots (SMTP).
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=you@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM=you@gmail.com

# --- Requests ---
# Only these addresses can request a screenshot by emailing the subject below to SMTP_USER.
# Each screenshot is emailed back only to the address that asked. Everything else is ignored.
TRUSTED_SENDERS=you@gmail.com, partner@example.com
TRIGGER_SUBJECT=status
# Seconds between inbox checks
CHECK_INTERVAL=15
# IMAP defaults (imap.gmail.com:993, same user and password as above). Override only if needed:
# IMAP_HOST=imap.gmail.com
# IMAP_FOLDER=INBOX

MAX_UPLOAD_MB=25
